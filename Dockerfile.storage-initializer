ARG PYTHON_VERSION=3.11
ARG BASE_IMAGE=python:${PYTHON_VERSION}-slim-bookworm
ARG VENV_PATH=/prod_venv

# ============================================================
# Builder
# ============================================================

FROM ${BASE_IMAGE} AS builder

ARG VENV_PATH
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       build-essential \
       curl \
       gcc \
       krb5-config \
       libkrb5-dev \
       python3-dev \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf \
      https://astral.sh/uv/0.11.21/install.sh \
      | sh \
    && ln -s \
      /root/.local/bin/uv \
      /usr/local/bin/uv \
    && uv --version

ENV VIRTUAL_ENV=${VENV_PATH}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV UV_HTTP_TIMEOUT=120

RUN uv venv "${VIRTUAL_ENV}"

WORKDIR /workspace/python

COPY .runtime-src/kserve/python/storage ./storage
COPY .runtime-src/kserve/python/storage-initializer ./storage-initializer

# ============================================================
# KServe storage dependencies
# ============================================================

RUN --mount=type=cache,target=/root/.cache/uv \
    cd storage \
    && uv lock \
       --upgrade-package aiohttp \
       --upgrade-package cryptography \
       --upgrade-package dulwich \
       --upgrade-package protobuf \
       --upgrade-package pyasn1 \
       --upgrade-package pyjwt \
       --upgrade-package urllib3 \
    && uv sync \
       --active \
       --no-dev \
    && uv pip install .

# Preserve upstream Kerberos / HDFS support.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
      krbcontext==0.10 \
      'hdfs~=2.6.0' \
      requests-kerberos==0.14.0

# ============================================================
# Validate production dependency environment
# ============================================================

RUN "${VIRTUAL_ENV}/bin/python" - <<'PY'
from importlib import metadata
from packaging.version import Version

minimums = {
    "aiohttp": "3.14.3",
    "cryptography": "50.0.0",
    "dulwich": "1.2.5",
    "protobuf": "6.33.5",
    "pyasn1": "0.6.4",
    "PyJWT": "2.13.0",
    "urllib3": "2.7.0",
}

print("===== RESOLVED STORAGE PACKAGES =====")

for package, minimum in minimums.items():
    installed = metadata.version(package)
    print(f"{package}={installed}")

    if Version(installed) < Version(minimum):
        raise SystemExit(
            f"ERROR: {package}={installed} "
            f"is below security floor {minimum}"
        )

print()
print("PASS: storage dependency security floors satisfied")
PY

# ============================================================
# Final runtime
# ============================================================

FROM ${BASE_IMAGE} AS prod

ARG VENV_PATH

ENV VIRTUAL_ENV=${VENV_PATH}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Packaging tooling is not required at runtime.
RUN /usr/local/bin/python -m pip uninstall \
      --yes \
      setuptools \
      wheel \
      pip

RUN useradd \
    --create-home \
    --uid 1000 \
    --home-dir /home/kserve \
    kserve

COPY --from=builder \
    --chown=kserve:kserve \
    ${VIRTUAL_ENV} \
    ${VIRTUAL_ENV}

COPY --from=builder \
    --chown=kserve:kserve \
    /workspace/python/storage \
    /storage

COPY --from=builder \
    --chown=kserve:kserve \
    /workspace/python/storage-initializer \
    /storage-initializer

RUN chmod +x \
      /storage-initializer/scripts/initializer-entrypoint \
    && mkdir -p /work \
    && chown -R kserve:kserve \
      /work \
      /mnt \
      /storage-initializer

WORKDIR /work

USER 1000

ENTRYPOINT ["/storage-initializer/scripts/initializer-entrypoint"]
