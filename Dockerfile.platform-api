# syntax=docker/dockerfile:1

# Build the AI Platform REST API binary.
FROM golang:1.26.6 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /workspace

COPY go.mod go.sum ./

RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY . .

RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 \
    GOOS=${TARGETOS:-linux} \
    GOARCH=${TARGETARCH} \
    go build \
      -trimpath \
      -ldflags="-s -w" \
      -o /platform-api \
      ./cmd/platform-api

# Minimal non-root runtime.
FROM gcr.io/distroless/static-debian13:nonroot

WORKDIR /

COPY --from=builder /platform-api /platform-api

USER 65532:65532

EXPOSE 8080

ENTRYPOINT ["/platform-api"]
